{
  "manifest_version": 3,
  "name": "iOS Safari profile",
  "description": "Makes page-visible browser properties match Safari on iPhone.",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": { "id": "ios-profile@firesafari.app" }
  },
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["spoof.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ]
}
